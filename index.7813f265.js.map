"use strict";
var bigImg = document.querySelector(".gallery__large-img");
var list = document.querySelector(".gallery__list");
list.addEventListener("click", function(e) {
    var link = e.target.closest(".list-item__link");
    if (!link) return;
    var currentImg = link.href;
    e.preventDefault();
    bigImg.setAttribute("src", currentImg);
});

